{
  "name": "@mizunagara/advanced-query-builder",
  "version": "0.1.0",
  "description": "Advanced query builder wrapper for the mizu design system",
  "license": "MIT",
  "homepage": "https://github.com/catalysync/mizu/tree/main/packages/advanced-query-builder#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/catalysync/mizu.git",
    "directory": "packages/advanced-query-builder"
  },
  "bugs": {
    "url": "https://github.com/catalysync/mizu/issues"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "sideEffects": false,
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "lint": "eslint ."
  },
  "peerDependencies": {
    "@mizunagara/css": ">=0.2.0",
    "@mizunagara/react": ">=0.2.0",
    "react": ">=18",
    "react-dom": ">=18",
    "@react-awesome-query-builder/ui": ">=6"
  },
  "files": [
    "dist"
  ],
  "devDependencies": {
    "@mizunagara/css": "workspace:^",
    "@mizunagara/react": "workspace:^",
    "@mizunagara/tsconfig": "workspace:^",
    "@react-awesome-query-builder/ui": "^6.6.3",
    "@types/react": "^19.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tsup": "^8.5.0",
    "typescript": "^5.9.0"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
