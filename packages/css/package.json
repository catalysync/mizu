{
  "name": "@mizunagara/css",
  "version": "0.1.0",
  "description": "Framework-agnostic component CSS for the mizu design system",
  "license": "MIT",
  "homepage": "https://github.com/catalysync/mizu/tree/main/packages/css#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/catalysync/mizu.git",
    "directory": "packages/css"
  },
  "bugs": {
    "url": "https://github.com/catalysync/mizu/issues"
  },
  "type": "module",
  "style": "./dist/mizu.css",
  "exports": {
    ".": "./dist/mizu.css",
    "./typography": "./dist/typography.css",
    "./components/*": "./dist/components/*.css",
    "./layouts/*": "./dist/layouts/*.css",
    "./shell/*": "./dist/shell/*.css",
    "./themes/*": "./dist/themes/*.css"
  },
  "scripts": {
    "build": "node build.mjs",
    "lint": "stylelint 'src/**/*.css'",
    "clean": "rm -rf dist",
    "test": "vitest run"
  },
  "peerDependencies": {
    "@mizunagara/tokens": ">=0.2.0"
  },
  "peerDependenciesMeta": {
    "@mizunagara/tokens": {
      "optional": true
    }
  },
  "devDependencies": {
    "@mizunagara/tokens": "workspace:^",
    "lightningcss": "^1.32.0",
    "vitest": "^3.0.0"
  },
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist",
    "src"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
