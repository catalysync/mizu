    "$description": "Black drop shadows disappear on a near-black page, so dark elevation adds a faint light edge ring to every shadow step.",
    "sm": {
      "$value": "0 0 0 1px rgb(255 255 255 / 6%), 0 1px 2px 0 rgb(0 0 0 / 60%)",
      "$type": "shadow"
    },
    "md": {
      "$value": "0 0 0 1px rgb(255 255 255 / 6%), 0 4px 6px -1px rgb(0 0 0 / 60%), 0 2px 4px -2px rgb(0 0 0 / 60%)",
