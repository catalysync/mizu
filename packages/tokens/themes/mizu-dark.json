  "text": {
    "$description": "Off-white primary text: pure #fff on near-black halates (glows) for many readers. Tertiary is slate-400 because slate-500 is 4.2:1 on the dark surface (below AA); slate-400 is 7.9:1.",
    "primary": {
      "$value": "{color.slate.100}",
      "$type": "color"
    },
    "secondary": {
      "$value": "{color.slate.400}",
      "$type": "color"
    },
    "inverse": {
      "$value": "{color.slate.900}",
      "$type": "color"
    },
    "disabled": {
      "$value": "{color.slate.600}",
      "$type": "color"
    },
    "tertiary": {
      "$value": "{color.slate.400}",
      "$type": "color"
    }
  },
  "feedback": {
    "$description": "Status colours on dark: default is the 300 step (text and icons on the subtle tint, 5:1 or better) and subtle is the 900 step, so a badge reads light-on-dark rather than inverting the light palette.",
    "success": {
      "default": {
        "$value": "{color.emerald.300}",
        "$type": "color"
      },
      "subtle": {
        "$value": "{color.emerald.900}",
        "$type": "color"
      }
    },
    "warning": {
